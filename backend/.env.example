# Backend SNC Referidos con PostgreSQL
PORT=3001
CORS_ORIGIN=*
PUBLIC_SITE_URL=http://localhost:3001

# PostgreSQL
# Local ejemplo:
# DATABASE_URL=postgresql://postgres:TU_PASSWORD@localhost:5432/snc_presale
# Render/Neon/Supabase ejemplo:
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
DATABASE_URL=postgresql://postgres:TU_PASSWORD@localhost:5432/snc_presale

# Usa true si tu proveedor exige SSL, por ejemplo Neon/Supabase/Render externo.
DATABASE_SSL=false

# BNB Smart Chain Mainnet
BSC_RPC_URL=https://bsc-dataseed.bnbchain.org
SALE_RECEIVER_ADDRESS=0x46E0076C4589882d3AC363Fbd658D0A39De12D89

# Comisión automática de referidos
REFERRAL_PERCENT=5
SNC_PER_BNB=12500
PRESALE_TOKENS_FOR_SALE=65000000
MIN_CONFIRMATIONS=1

# Seguridad admin
ADMIN_KEY=cambia_esta_clave_admin_por_una_larga_y_segura
